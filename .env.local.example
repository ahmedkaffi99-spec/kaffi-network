# Supabase (obligatoire) — client anon, utilisé par le dashboard Next.js
# (lecture des pages, Auth). Le service role reste dans backend/.env,
# jamais ici.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend Python local (voir backend/README.md) — le frontend ne fait plus
# aucun appel API externe directement, il relaie vers ce serveur.
PYTHON_BACKEND_URL=http://127.0.0.1:8000
# Doit être IDENTIQUE à LOCAL_BACKEND_SECRET dans backend/.env.
LOCAL_BACKEND_SECRET=change-moi-en-un-secret-long-et-aleatoire
