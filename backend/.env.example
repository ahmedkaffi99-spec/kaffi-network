# Copie ce fichier en .env et remplis-le. Mêmes clés externes que le site
# Next.js — seul SUPABASE_SERVICE_ROLE_KEY doit rester ici (jamais côté
# frontend), et LOCAL_BACKEND_SECRET est nouveau (voir backend/README.md).

# Supabase (reste dans le cloud — aucune donnée locale)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secret partagé avec le frontend Next.js local (voir local_auth.py)
LOCAL_BACKEND_SECRET=

# LLM — OpenRouter (gratuit) + Groq (gratuit, optionnel)
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Données football
API_FOOTBALL_KEY=
ODDS_API_KEY=
SERPER_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Affiliation
AFFILIATE_LINK=
